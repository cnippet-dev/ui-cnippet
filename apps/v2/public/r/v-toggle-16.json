{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "v-toggle-16",
  "description": "Showcase: variants, sizes, icons and states",
  "registryDependencies": [
    "@cnippet/toggle"
  ],
  "files": [
    {
      "path": "registry/default/variants/v-toggle-16.tsx",
      "content": "import { BoldIcon, BookmarkIcon, ItalicIcon, StarIcon } from \"lucide-react\";\nimport { Toggle } from \"@/registry/default/ui/toggle\";\n\nfunction Row({\n  label,\n  children,\n}: {\n  label: string;\n  children: React.ReactNode;\n}) {\n  return (\n    <div className=\"grid gap-2 sm:grid-cols-[5rem_1fr] sm:items-center\">\n      <span className=\"text-muted-foreground text-xs\">{label}</span>\n      <div className=\"flex flex-wrap items-center gap-2\">{children}</div>\n    </div>\n  );\n}\n\nexport default function Particle() {\n  return (\n    <div className=\"flex w-full max-w-md flex-col gap-4\">\n      <Row label=\"Variants\">\n        <Toggle aria-label=\"Toggle bold\">\n          <BoldIcon />\n          Default\n        </Toggle>\n        <Toggle aria-label=\"Toggle italic\" variant=\"outline\">\n          <ItalicIcon />\n          Outline\n        </Toggle>\n      </Row>\n      <Row label=\"Sizes\">\n        <Toggle size=\"sm\" variant=\"outline\">\n          Small\n        </Toggle>\n        <Toggle variant=\"outline\">Default</Toggle>\n        <Toggle size=\"lg\" variant=\"outline\">\n          Large\n        </Toggle>\n      </Row>\n      <Row label=\"Icon only\">\n        <Toggle aria-label=\"Bold\" variant=\"outline\">\n          <BoldIcon />\n        </Toggle>\n        <Toggle aria-label=\"Italic\" variant=\"outline\">\n          <ItalicIcon />\n        </Toggle>\n        <Toggle aria-label=\"Favourite\" defaultPressed variant=\"outline\">\n          <StarIcon />\n        </Toggle>\n      </Row>\n      <Row label=\"States\">\n        <Toggle defaultPressed variant=\"outline\">\n          <BookmarkIcon />\n          Pressed\n        </Toggle>\n        <Toggle disabled variant=\"outline\">\n          Disabled\n        </Toggle>\n      </Row>\n    </div>\n  );\n}\n",
      "type": "registry:block"
    }
  ],
  "meta": {
    "className": "",
    "role": "showcase"
  },
  "categories": [
    "toggle"
  ],
  "type": "registry:block"
}