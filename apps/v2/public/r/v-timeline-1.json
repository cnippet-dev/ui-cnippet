{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "v-timeline-1",
  "description": "Pull request activity feed with avatars and icons",
  "registryDependencies": [
    "@cnippet/timeline",
    "@cnippet/avatar",
