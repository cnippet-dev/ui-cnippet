  "files": [
    {
      "path": "registry/default/variants/v-progress-16.tsx",
      "content": "// title: Showcase: plain, labelled and formatted value\n\"use client\";\n\nimport {\n  Progress,\n  ProgressIndicator,\n  ProgressLabel,\n  ProgressTrack,\n  ProgressValue,\n} from \"@/registry/default/ui/progress\";\n\nexport default function Particle() {\n  return (\n    <div className=\"flex w-full max-w-sm flex-col gap-5\">\n      <Progress value={64}>\n        <ProgressTrack>\n          <ProgressIndicator />\n        </ProgressTrack>\n      </Progress>\n      <Progress value={64}>\n        <div className=\"flex items-center justify-between gap-2\">\n          <ProgressLabel>Installing</ProgressLabel>\n          <ProgressValue />\n        </div>\n        <ProgressTrack>\n          <ProgressIndicator />\n        </ProgressTrack>\n      </Progress>\n      <Progress max={512} value={384}>\n        <div className=\"flex items-center justify-between gap-2\">\n          <ProgressLabel>Upload</ProgressLabel>\n          <ProgressValue>\n            {(_formatted, value) => `${value} / 512 MB`}\n          </ProgressValue>\n        </div>\n        <ProgressTrack>\n          <ProgressIndicator />\n        </ProgressTrack>\n      </Progress>\n    </div>\n  );\n}\n",
      "type": "registry:block"
    }
  ],
  "meta": {
    "className": "",
    "role": "showcase"
  },
  "categories": [
    "progress"
  ],
  "type": "registry:block"
}