{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "v-sidebar-1",
  "description": "App shell with icon collapse, groups, badges and user footer",
  "registryDependencies": [
    "@cnippet/sidebar",
    "@cnippet/avatar",
    "@cnippet/collapsible",
    "@cnippet/label",
    "@cnippet/separator"
  ],
  "files": [
    {
      "path": "registry/default/variants/v-sidebar-1.tsx",
      "content": "// title: App shell with icon collapse, groups, badges and user footer\n\"use client\";\n\nimport {\n  BarChart3Icon,\n  BoxIcon,\n  ChevronsUpDownIcon,\n  FolderIcon,\n  HomeIcon,\n  InboxIcon,\n  PlusIcon,\n  SettingsIcon,\n  UsersIcon,\n} from \"lucide-react\";\nimport { useState } from \"react\";\nimport { Avatar, AvatarFallback } from \"@/registry/default/ui/avatar\";\nimport { Separator } from \"@/registry/default/ui/separator\";\nimport {\n  Sidebar,\n  SidebarContent,\n  SidebarFooter,\n  SidebarGroup,\n  SidebarGroupAction,\n  SidebarGroupContent,\n  SidebarGroupLabel,\n  SidebarHeader,\n  SidebarInset,\n  SidebarMenu,\n  SidebarMenuBadge,\n  SidebarMenuButton,\n  SidebarMenuItem,\n  SidebarProvider,\n  SidebarRail,\n  SidebarTrigger,\n} from \"@/registry/default/ui/sidebar\";\n\nconst NAV = [\n  { icon: HomeIcon, label: \"Overview\" },\n  { badge: 12, icon: InboxIcon, label: \"Inbox\" },\n  { icon: BarChart3Icon, label: \"Analytics\" },\n  { icon: UsersIcon, label: \"Customers\" },\n];\n\nconst PROJECTS = [\"Website redesign\", \"Mobile app\", \"Design system\"];\n\nexport default function Particle() {\n  const [active, setActive] = useState(\"Overview\");\n\n  return (\n    // The transform makes this box the containing block for the sidebar's\n    // fixed positioning, so the demo stays inside the preview.\n    <div className=\"flex h-88 w-full transform-gpu overflow-hidden rounded-xl border\">\n      <SidebarProvider className=\"h-full min-h-0\">\n        <Sidebar className=\"h-full\" collapsible=\"icon\">\n          <SidebarHeader>\n            <SidebarMenu>\n              <SidebarMenuItem>\n                <SidebarMenuButton size=\"lg\" tooltip=\"Acme Inc\">\n                  <span className=\"flex size-8 shrink-0 items-center justify-center rounded-lg bg-primary text-primary-foreground\">\n                    <BoxIcon aria-hidden=\"true\" className=\"size-4\" />\n                  </span>\n                  <span className=\"grid flex-1 text-left leading-tight\">\n                    <span className=\"truncate font-medium\">Acme Inc</span>\n                    <span className=\"truncate text-muted-foreground text-xs\">\n                      Pro plan\n                    </span>\n                  </span>\n                  <ChevronsUpDownIcon aria-hidden=\"true\" className=\"ms-auto\" />\n                </SidebarMenuButton>\n              </SidebarMenuItem>\n            </SidebarMenu>\n          </SidebarHeader>\n          <SidebarContent>\n            <SidebarGroup>\n              <SidebarGroupLabel>Workspace</SidebarGroupLabel>\n              <SidebarGroupContent>\n                <SidebarMenu>\n                  {NAV.map((item) => (\n                    <SidebarMenuItem key={item.label}>\n                      <SidebarMenuButton\n                        isActive={active === item.label}\n                        onClick={() => setActive(item.label)}\n                        tooltip={item.label}\n                      >\n                        <item.icon aria-hidden=\"true\" />\n                        <span>{item.label}</span>\n                      </SidebarMenuButton>\n                      {item.badge && (\n                        <SidebarMenuBadge>{item.badge}</SidebarMenuBadge>\n                      )}\n                    </SidebarMenuItem>\n                  ))}\n                </SidebarMenu>\n              </SidebarGroupContent>\n            </SidebarGroup>\n            <SidebarGroup>\n              <SidebarGroupLabel>Projects</SidebarGroupLabel>\n              <SidebarGroupAction aria-label=\"New project\">\n                <PlusIcon aria-hidden=\"true\" />\n              </SidebarGroupAction>\n              <SidebarGroupContent>\n                <SidebarMenu>\n                  {PROJECTS.map((project) => (\n                    <SidebarMenuItem key={project}>\n                      <SidebarMenuButton\n                        isActive={active === project}\n                        onClick={() => setActive(project)}\n                        tooltip={project}\n                      >\n                        <FolderIcon aria-hidden=\"true\" />\n                        <span>{project}</span>\n                      </SidebarMenuButton>\n                    </SidebarMenuItem>\n                  ))}\n                </SidebarMenu>\n              </SidebarGroupContent>\n            </SidebarGroup>\n          </SidebarContent>\n          <SidebarFooter>\n            <SidebarMenu>\n              <SidebarMenuItem>\n                <SidebarMenuButton tooltip=\"Settings\">\n                  <SettingsIcon aria-hidden=\"true\" />\n                  <span>Settings</span>\n                </SidebarMenuButton>\n              </SidebarMenuItem>\n              <SidebarMenuItem>\n                <SidebarMenuButton size=\"lg\" tooltip=\"Maya Patel\">\n                  <Avatar className=\"size-8 rounded-lg\">\n                    <AvatarFallback className=\"rounded-lg text-xs\">\n                      MP\n                    </AvatarFallback>\n                  </Avatar>\n                  <span className=\"grid flex-1 text-left leading-tight\">\n                    <span className=\"truncate font-medium\">Maya Patel</span>\n                    <span className=\"truncate text-muted-foreground text-xs\">\n                      maya@acme.dev\n                    </span>\n                  </span>\n                </SidebarMenuButton>\n              </SidebarMenuItem>\n            </SidebarMenu>\n          </SidebarFooter>\n          <SidebarRail />\n        </Sidebar>\n        <SidebarInset className=\"min-w-0\">\n          <header className=\"flex h-12 shrink-0 items-center gap-2 border-b px-3\">\n            <SidebarTrigger />\n            <Separator className=\"h-4\" orientation=\"vertical\" />\n            <span className=\"font-medium text-sm\">{active}</span>\n          </header>\n          <div className=\"grid gap-3 p-4 sm:grid-cols-3\">\n            {[\"Revenue\", \"Orders\", \"Visitors\"].map((label) => (\n              <div className=\"h-20 rounded-lg bg-muted/50 p-3\" key={label}>\n                <p className=\"text-muted-foreground text-xs\">{label}</p>\n              </div>\n            ))}\n            <div className=\"h-40 rounded-lg bg-muted/50 sm:col-span-3\" />\n          </div>\n        </SidebarInset>\n      </SidebarProvider>\n    </div>\n  );\n}\n",
      "type": "registry:block"
    }
  ],
  "meta": {
    "className": "**:data-[slot=preview]:w-full sm:**:data-[slot=preview]:max-w-[90%]",
    "role": "showcase"
  },
  "categories": [
    "sidebar"
  ],
  "type": "registry:block"
}