{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "v-context-menu-4",
  "description": "Calendar events with labelled action groups",
  "registryDependencies": [
    "@cnippet/menu"
  ],
  "files": [
    {
      "path": "registry/default/variants/v-context-menu-4.tsx",
      "content": "import {\n  CalendarArrowUpIcon,\n  CalendarClockIcon,\n  CheckIcon,\n  CopyIcon,\n  HelpCircleIcon,\n  LinkIcon,\n  PencilIcon,\n  TrashIcon,\n  XIcon,\n} from \"lucide-react\";\nimport {\n  ContextMenu,\n  ContextMenuContent,\n  ContextMenuGroup,\n  ContextMenuItem,\n  ContextMenuLabel,\n  ContextMenuSeparator,\n  ContextMenuShortcut,\n  ContextMenuTrigger,\n} from \"@/registry/default/ui/context-menu\";\n\nconst EVENTS = [\n  { id: \"e1\", time: \"09:30 – 10:00\", title: \"Design review\" },\n  { id: \"e2\", time: \"11:00 – 12:00\", title: \"Sprint planning\" },\n  { id: \"e3\", time: \"14:30 – 15:00\", title: \"1:1 with Celia\" },\n];\n\nexport function ContextMenuGroups() {\n  return (\n    <div className=\"w-full max-w-sm rounded-xl border bg-background p-3 shadow-xs/5\">\n      <div className=\"mb-3 flex items-baseline justify-between px-1\">\n        <p className=\"font-semibold text-sm\">Thursday</p>\n        <p className=\"text-muted-foreground text-xs\">\n          <span className=\"pointer-fine:inline hidden\">\n            Right-click an event\n          </span>\n          <span className=\"pointer-coarse:inline hidden\">\n            Long-press an event\n          </span>\n        </p>\n      </div>\n      <div className=\"space-y-1.5\">\n        {EVENTS.map((event) => (\n          <ContextMenu key={event.id}>\n            <ContextMenuTrigger className=\"flex w-full items-center gap-3 rounded-lg border-primary border-s-2 bg-muted/60 px-3 py-2 text-start\">\n              <div className=\"min-w-0 flex-1\">\n                <p className=\"truncate font-medium text-sm\">{event.title}</p>\n                <p className=\"text-muted-foreground text-xs\">{event.time}</p>\n              </div>\n            </ContextMenuTrigger>\n            <ContextMenuContent className=\"w-52\">\n              <ContextMenuGroup>\n                <ContextMenuLabel>Event</ContextMenuLabel>\n                <ContextMenuItem>\n                  <PencilIcon />\n                  Edit\n                  <ContextMenuShortcut>E</ContextMenuShortcut>\n                </ContextMenuItem>\n                <ContextMenuItem>\n                  <CopyIcon />\n                  Duplicate\n                  <ContextMenuShortcut>⌘D</ContextMenuShortcut>\n                </ContextMenuItem>\n                <ContextMenuItem>\n                  <LinkIcon />\n                  Copy link\n                </ContextMenuItem>\n              </ContextMenuGroup>\n              <ContextMenuSeparator />\n              <ContextMenuGroup>\n                <ContextMenuLabel>Respond</ContextMenuLabel>\n                <ContextMenuItem>\n                  <CheckIcon />\n                  Going\n                </ContextMenuItem>\n                <ContextMenuItem>\n                  <HelpCircleIcon />\n                  Maybe\n                </ContextMenuItem>\n                <ContextMenuItem>\n                  <XIcon />\n                  Not going\n                </ContextMenuItem>\n              </ContextMenuGroup>\n              <ContextMenuSeparator />\n              <ContextMenuGroup>\n                <ContextMenuLabel>Move</ContextMenuLabel>\n                <ContextMenuItem>\n                  <CalendarClockIcon />\n                  Tomorrow\n                </ContextMenuItem>\n                <ContextMenuItem>\n                  <CalendarArrowUpIcon />\n                  Next week\n                </ContextMenuItem>\n              </ContextMenuGroup>\n              <ContextMenuSeparator />\n              <ContextMenuGroup>\n                <ContextMenuItem variant=\"destructive\">\n                  <TrashIcon />\n                  Delete event\n                  <ContextMenuShortcut>⌫</ContextMenuShortcut>\n                </ContextMenuItem>\n              </ContextMenuGroup>\n            </ContextMenuContent>\n          </ContextMenu>\n        ))}\n      </div>\n    </div>\n  );\n}\n",
      "type": "registry:block"
    }
  ],
  "meta": {
    "className": ""
  },
  "categories": [
    "context menu"
  ],
  "type": "registry:block"
}