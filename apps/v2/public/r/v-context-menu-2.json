{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "v-context-menu-2",
  "description": "Media library with Move to and Share submenus",
  "registryDependencies": [
    "@cnippet/menu"
  ],
  "files": [
    {
      "path": "registry/default/variants/v-context-menu-2.tsx",
      "content": "\"use client\";\n\nimport {\n  CopyIcon,\n  DownloadIcon,\n  FolderIcon,\n  FolderInputIcon,\n  FolderPlusIcon,\n  ImageIcon,\n  LinkIcon,\n  MailIcon,\n  MessageSquareIcon,\n  Share2Icon,\n  TrashIcon,\n} from \"lucide-react\";\nimport { useState } from \"react\";\nimport {\n  ContextMenu,\n  ContextMenuContent,\n  ContextMenuGroup,\n  ContextMenuItem,\n  ContextMenuSeparator,\n  ContextMenuSub,\n  ContextMenuSubContent,\n  ContextMenuSubTrigger,\n  ContextMenuTrigger,\n} from \"@/registry/default/ui/context-menu\";\n\nconst FOLDERS = [\"Brand\", \"Campaigns\", \"Archive\"];\n\nconst INITIAL_ASSETS = [\n  { folder: \"Brand\", id: \"a1\", name: \"logo-mark.svg\" },\n  { folder: \"Campaigns\", id: \"a2\", name: \"launch-hero.png\" },\n  { folder: \"Campaigns\", id: \"a3\", name: \"pricing-og.png\" },\n  { folder: \"Brand\", id: \"a4\", name: \"team-offsite.jpg\" },\n];\n\nexport function ContextMenuSubmenu() {\n  const [assets, setAssets] = useState(INITIAL_ASSETS);\n\n  const moveTo = (id: string, folder: string) =>\n    setAssets((prev) => prev.map((a) => (a.id === id ? { ...a, folder } : a)));\n\n  return (\n    <div className=\"w-full max-w-md space-y-2\">\n      <div className=\"grid grid-cols-2 gap-2\">\n        {assets.map((asset) => (\n          <ContextMenu key={asset.id}>\n            <ContextMenuTrigger className=\"group block overflow-hidden rounded-lg border bg-background\">\n              <div className=\"flex aspect-[4/3] items-center justify-center bg-muted\">\n                <ImageIcon\n                  aria-hidden=\"true\"\n                  className=\"size-6 text-muted-foreground/60\"\n                />\n              </div>\n              <div className=\"flex items-center justify-between gap-2 px-2.5 py-2\">\n                <span className=\"truncate font-medium text-xs\">\n                  {asset.name}\n                </span>\n                <span className=\"flex shrink-0 items-center gap-1 text-[11px] text-muted-foreground\">\n                  <FolderIcon aria-hidden=\"true\" className=\"size-3\" />\n                  {asset.folder}\n                </span>\n              </div>\n            </ContextMenuTrigger>\n            <ContextMenuContent className=\"w-48\">\n              <ContextMenuGroup>\n                <ContextMenuItem>\n                  <DownloadIcon />\n                  Download\n                </ContextMenuItem>\n                <ContextMenuItem>\n                  <CopyIcon />\n                  Duplicate\n                </ContextMenuItem>\n              </ContextMenuGroup>\n              <ContextMenuSeparator />\n              <ContextMenuGroup>\n                <ContextMenuSub>\n                  <ContextMenuSubTrigger>\n                    <FolderInputIcon />\n                    Move to\n                  </ContextMenuSubTrigger>\n                  <ContextMenuSubContent className=\"w-40\">\n                    <ContextMenuGroup>\n                      {FOLDERS.map((folder) => (\n                        <ContextMenuItem\n                          disabled={folder === asset.folder}\n                          key={folder}\n                          onClick={() => moveTo(asset.id, folder)}\n                        >\n                          <FolderIcon />\n                          {folder}\n                        </ContextMenuItem>\n                      ))}\n                    </ContextMenuGroup>\n                    <ContextMenuSeparator />\n                    <ContextMenuGroup>\n                      <ContextMenuItem>\n                        <FolderPlusIcon />\n                        New folder…\n                      </ContextMenuItem>\n                    </ContextMenuGroup>\n                  </ContextMenuSubContent>\n                </ContextMenuSub>\n                <ContextMenuSub>\n                  <ContextMenuSubTrigger>\n                    <Share2Icon />\n                    Share\n                  </ContextMenuSubTrigger>\n                  <ContextMenuSubContent className=\"w-40\">\n                    <ContextMenuGroup>\n                      <ContextMenuItem>\n                        <LinkIcon />\n                        Copy link\n                      </ContextMenuItem>\n                      <ContextMenuItem>\n                        <MailIcon />\n                        Email\n                      </ContextMenuItem>\n                      <ContextMenuItem>\n                        <MessageSquareIcon />\n                        Send to Slack\n                      </ContextMenuItem>\n                    </ContextMenuGroup>\n                  </ContextMenuSubContent>\n                </ContextMenuSub>\n              </ContextMenuGroup>\n              <ContextMenuSeparator />\n              <ContextMenuGroup>\n                <ContextMenuItem variant=\"destructive\">\n                  <TrashIcon />\n                  Delete\n                </ContextMenuItem>\n              </ContextMenuGroup>\n            </ContextMenuContent>\n          </ContextMenu>\n        ))}\n      </div>\n      <p className=\"text-muted-foreground text-xs\">\n        <span className=\"pointer-fine:inline hidden\">\n          Right-click an asset to move or share it.\n        </span>\n        <span className=\"pointer-coarse:inline hidden\">\n          Long-press an asset to move or share it.\n        </span>\n      </p>\n    </div>\n  );\n}\n",
      "type": "registry:block"
    }
  ],
  "meta": {
    "className": ""
  },
  "categories": [
    "context menu"
  ],
  "type": "registry:block"
}