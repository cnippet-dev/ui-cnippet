{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "v-group-19",
  "description": "Showcase: outline, small, primary and with input",
  "registryDependencies": [
    "@cnippet/group"
  ],
  "files": [
    {
      "path": "registry/default/variants/v-group-19.tsx",
      "content": "// title: Showcase: outline, small, primary and with input\nimport {\n  ChevronDownIcon,\n  FilesIcon,\n  FilmIcon,\n  MinusIcon,\n  PlusIcon,\n} from \"lucide-react\";\nimport { Button } from \"@/registry/default/ui/button\";\nimport { Group, GroupSeparator } from \"@/registry/default/ui/group\";\nimport { Input } from \"@/registry/default/ui/input\";\n\nfunction Row({\n  label,\n  children,\n}: {\n  label: string;\n  children: React.ReactNode;\n}) {\n  return (\n    <div className=\"grid gap-2 sm:grid-cols-[5rem_1fr] sm:items-center\">\n      <span className=\"text-muted-foreground text-xs\">{label}</span>\n      <div className=\"flex flex-wrap items-center gap-3\">{children}</div>\n    </div>\n  );\n}\n\nexport default function Particle() {\n  return (\n    <div className=\"flex w-full max-w-lg flex-col gap-4\">\n      <Row label=\"Outline\">\n        <Group aria-label=\"Library\">\n          <Button variant=\"outline\">\n            <FilesIcon aria-hidden=\"true\" />\n            Files\n          </Button>\n          <GroupSeparator />\n          <Button variant=\"outline\">\n            <FilmIcon aria-hidden=\"true\" />\n            Media\n          </Button>\n          <GroupSeparator />\n          <Button disabled variant=\"outline\">\n            Archive\n          </Button>\n        </Group>\n      </Row>\n      <Row label=\"Small\">\n        <Group aria-label=\"Zoom\">\n          <Button aria-label=\"Zoom out\" size=\"icon-sm\" variant=\"outline\">\n            <MinusIcon aria-hidden=\"true\" />\n          </Button>\n          <GroupSeparator />\n          <Button size=\"sm\" variant=\"outline\">\n            100%\n          </Button>\n          <GroupSeparator />\n          <Button aria-label=\"Zoom in\" size=\"icon-sm\" variant=\"outline\">\n            <PlusIcon aria-hidden=\"true\" />\n          </Button>\n        </Group>\n      </Row>\n      <Row label=\"Primary\">\n        <Group aria-label=\"Deploy\">\n          <Button>Deploy</Button>\n          <GroupSeparator className=\"bg-primary/72\" />\n          <Button aria-label=\"More deploy options\" size=\"icon\">\n            <ChevronDownIcon aria-hidden=\"true\" />\n          </Button>\n        </Group>\n      </Row>\n      <Row label=\"With input\">\n        <Group aria-label=\"Invite\">\n          <Input aria-label=\"Email\" placeholder=\"teammate@acme.com\" />\n          <GroupSeparator />\n          <Button variant=\"outline\">Invite</Button>\n        </Group>\n      </Row>\n    </div>\n  );\n}\n",
      "type": "registry:block"
    }
  ],
  "meta": {
    "className": "",
    "role": "showcase"
  },
  "categories": [
    "group"
  ],
  "type": "registry:block"
}