  "files": [
    {
      "path": "registry/default/variants/v-toggle-group-16.tsx",
      "content": "// title: Showcase: single, multiple, outline and vertical\nimport {\n  AlignCenterIcon,\n  AlignLeftIcon,\n  AlignRightIcon,\n  BoldIcon,\n  ItalicIcon,\n  UnderlineIcon,\n} from \"lucide-react\";\nimport {\n  ToggleGroup,\n  ToggleGroupItem,\n} from \"@/registry/default/ui/toggle-group\";\n\nfunction Row({\n  label,\n  children,\n}: {\n  label: string;\n  children: React.ReactNode;\n}) {\n  return (\n    <div className=\"grid gap-2 sm:grid-cols-[6rem_1fr] sm:items-center\">\n      <span className=\"text-muted-foreground text-xs\">{label}</span>\n      <div className=\"flex flex-wrap items-center gap-3\">{children}</div>\n    </div>\n  );\n}\n\nexport default function Particle() {\n  return (\n    <div className=\"flex w-full max-w-md flex-col gap-4\">\n      <Row label=\"Single\">\n        <ToggleGroup defaultValue={[\"left\"]}>\n          <ToggleGroupItem aria-label=\"Align left\" value=\"left\">\n            <AlignLeftIcon />\n          </ToggleGroupItem>\n          <ToggleGroupItem aria-label=\"Align center\" value=\"center\">\n            <AlignCenterIcon />\n          </ToggleGroupItem>\n          <ToggleGroupItem aria-label=\"Align right\" value=\"right\">\n            <AlignRightIcon />\n          </ToggleGroupItem>\n        </ToggleGroup>\n      </Row>\n      <Row label=\"Multiple\">\n        <ToggleGroup defaultValue={[\"bold\", \"italic\"]} multiple>\n          <ToggleGroupItem aria-label=\"Bold\" value=\"bold\">\n            <BoldIcon />\n          </ToggleGroupItem>\n          <ToggleGroupItem aria-label=\"Italic\" value=\"italic\">\n            <ItalicIcon />\n          </ToggleGroupItem>\n          <ToggleGroupItem aria-label=\"Underline\" value=\"underline\">\n            <UnderlineIcon />\n          </ToggleGroupItem>\n        </ToggleGroup>\n      </Row>\n      <Row label=\"Outline sizes\">\n        <ToggleGroup defaultValue={[\"week\"]} size=\"sm\" variant=\"outline\">\n          <ToggleGroupItem value=\"day\">Day</ToggleGroupItem>\n          <ToggleGroupItem value=\"week\">Week</ToggleGroupItem>\n          <ToggleGroupItem value=\"month\">Month</ToggleGroupItem>\n        </ToggleGroup>\n        <ToggleGroup defaultValue={[\"week\"]} size=\"lg\" variant=\"outline\">\n          <ToggleGroupItem value=\"day\">Day</ToggleGroupItem>\n          <ToggleGroupItem value=\"week\">Week</ToggleGroupItem>\n          <ToggleGroupItem value=\"month\">Month</ToggleGroupItem>\n        </ToggleGroup>\n      </Row>\n      <Row label=\"Vertical\">\n        <ToggleGroup\n          defaultValue={[\"list\"]}\n          orientation=\"vertical\"\n          variant=\"outline\"\n        >\n          <ToggleGroupItem value=\"list\">List</ToggleGroupItem>\n          <ToggleGroupItem value=\"board\">Board</ToggleGroupItem>\n          <ToggleGroupItem value=\"calendar\">Calendar</ToggleGroupItem>\n        </ToggleGroup>\n      </Row>\n    </div>\n  );\n}\n",
      "type": "registry:block"
    }
  ],
  "meta": {
    "className": "",
    "role": "showcase"
  },
  "categories": [
    "toggle group"
  ],
  "type": "registry:block"
