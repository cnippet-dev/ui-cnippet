{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "v-pagination-11",
  "description": "Rows per page with first/last navigation",
  "registryDependencies": [
    "@cnippet/pagination"
  ],
  "files": [
    {
      "path": "registry/default/variants/v-pagination-11.tsx",
      "content": "// title: Rows per page with first/last navigation\nimport {\n  ChevronFirstIcon,\n  ChevronLastIcon,\n  ChevronLeftIcon,\n  ChevronRightIcon,\n} from \"lucide-react\";\nimport {\n  Pagination,\n  PaginationContent,\n  PaginationItem,\n  PaginationLink,\n} from \"@/registry/default/ui/pagination\";\nimport {\n  Select,\n  SelectItem,\n  SelectPopup,\n  SelectTrigger,\n  SelectValue,\n} from \"@/registry/default/ui/select\";\n\nconst rows = [10, 25, 50, 100].map((value) => ({ label: String(value), value }));\n\nexport function Pattern() {\n  return (\n    <Pagination>\n      <PaginationContent className=\"w-full justify-between\">\n        <PaginationItem className=\"flex items-center gap-2\">\n          <span className=\"whitespace-nowrap text-muted-foreground text-sm\">\n            Rows per page\n          </span>\n          <Select defaultValue={25} items={rows}>\n            <SelectTrigger aria-label=\"Rows per page\" className=\"w-20\" size=\"sm\">\n              <SelectValue />\n            </SelectTrigger>\n            <SelectPopup>\n              {rows.map((item) => (\n                <SelectItem key={item.value} value={item.value}>\n                  {item.label}\n                </SelectItem>\n              ))}\n            </SelectPopup>\n          </Select>\n        </PaginationItem>\n        <PaginationItem className=\"flex items-center gap-3\">\n          <span className=\"whitespace-nowrap text-muted-foreground text-sm\">\n            1-25 of 100\n          </span>\n          <div className=\"flex gap-1\">\n            <PaginationLink aria-label=\"Go to first page\" href=\"#\" size=\"icon\">\n              <ChevronFirstIcon className=\"size-4\" />\n            </PaginationLink>\n            <PaginationLink\n              aria-label=\"Go to previous page\"\n              href=\"#\"\n              size=\"icon\"\n            >\n              <ChevronLeftIcon className=\"size-4\" />\n            </PaginationLink>\n            <PaginationLink aria-label=\"Go to next page\" href=\"#\" size=\"icon\">\n              <ChevronRightIcon className=\"size-4\" />\n            </PaginationLink>\n            <PaginationLink aria-label=\"Go to last page\" href=\"#\" size=\"icon\">\n              <ChevronLastIcon className=\"size-4\" />\n            </PaginationLink>\n          </div>\n        </PaginationItem>\n      </PaginationContent>\n    </Pagination>\n  );\n}\n",
      "type": "registry:block"
    }
  ],
  "meta": {
    "className": ""
  },
  "categories": [
    "pagination"
  ],
  "type": "registry:block"
}