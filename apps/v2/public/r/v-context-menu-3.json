{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "v-context-menu-3",
  "description": "Code editor with keyboard shortcuts",
  "registryDependencies": [
    "@cnippet/menu"
  ],
  "files": [
    {
      "path": "registry/default/variants/v-context-menu-3.tsx",
      "content": "// title: Code editor with keyboard shortcuts\nimport {\n  ContextMenu,\n  ContextMenuContent,\n  ContextMenuGroup,\n  ContextMenuItem,\n  ContextMenuSeparator,\n  ContextMenuShortcut,\n  ContextMenuTrigger,\n} from \"@/registry/default/ui/context-menu\";\n\nconst CODE = [\n  'import { formatPrice } from \"@/lib/format\";',\n  \"\",\n  \"export function PriceTag({ amount }: Props) {\",\n  \"  const label = formatPrice(amount);\",\n  '  return <span className=\"tag\">{label}</span>;',\n  \"}\",\n];\n\nexport function ContextMenuShortcuts() {\n  return (\n    <div className=\"w-full max-w-md overflow-hidden rounded-xl border bg-background shadow-xs/5\">\n      <div className=\"flex items-center justify-between border-b px-3 py-2\">\n        <span className=\"font-mono text-muted-foreground text-xs\">\n          price-tag.tsx\n        </span>\n        <span className=\"text-muted-foreground text-xs\">\n          <span className=\"pointer-fine:inline hidden\">Right-click code</span>\n          <span className=\"pointer-coarse:inline hidden\">Long-press code</span>\n        </span>\n      </div>\n      <ContextMenu>\n        <ContextMenuTrigger className=\"block overflow-x-auto py-3 font-mono text-xs leading-6\">\n          {CODE.map((line, i) => (\n            <div className=\"flex\" key={`${i}-${line}`}>\n              <span className=\"w-10 shrink-0 select-none pe-3 text-end text-muted-foreground/60\">\n                {i + 1}\n              </span>\n              <span className=\"whitespace-pre text-foreground/90\">{line}</span>\n            </div>\n          ))}\n        </ContextMenuTrigger>\n        <ContextMenuContent className=\"w-60\">\n          <ContextMenuGroup>\n            <ContextMenuItem>\n              Go to Definition\n              <ContextMenuShortcut>F12</ContextMenuShortcut>\n            </ContextMenuItem>\n            <ContextMenuItem>\n              Go to References\n              <ContextMenuShortcut>⇧F12</ContextMenuShortcut>\n            </ContextMenuItem>\n            <ContextMenuItem>\n              Rename Symbol\n              <ContextMenuShortcut>F2</ContextMenuShortcut>\n            </ContextMenuItem>\n          </ContextMenuGroup>\n          <ContextMenuSeparator />\n          <ContextMenuGroup>\n            <ContextMenuItem>\n              Cut\n              <ContextMenuShortcut>⌘X</ContextMenuShortcut>\n            </ContextMenuItem>\n            <ContextMenuItem>\n              Copy\n              <ContextMenuShortcut>⌘C</ContextMenuShortcut>\n            </ContextMenuItem>\n            <ContextMenuItem>\n              Paste\n              <ContextMenuShortcut>⌘V</ContextMenuShortcut>\n            </ContextMenuItem>\n          </ContextMenuGroup>\n          <ContextMenuSeparator />\n          <ContextMenuGroup>\n            <ContextMenuItem>\n              Format Document\n              <ContextMenuShortcut>⇧⌥F</ContextMenuShortcut>\n            </ContextMenuItem>\n            <ContextMenuItem>\n              Command Palette\n              <ContextMenuShortcut>⇧⌘P</ContextMenuShortcut>\n            </ContextMenuItem>\n          </ContextMenuGroup>\n        </ContextMenuContent>\n      </ContextMenu>\n    </div>\n  );\n}\n",
      "type": "registry:block"
    }
  ],
  "meta": {
    "className": ""
  },
  "categories": [
    "context menu"
  ],
  "type": "registry:block"
}